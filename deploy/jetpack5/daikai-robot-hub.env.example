# Optional overrides installed as /etc/default/daikai-robot-hub.
# Use absolute paths: systemd does not expand $HOME or shell expressions here.
UNITREE_NETWORK_INTERFACE=eth10
DAIKAI_BACKEND_PORT=8010
R1_YOLO_DEVICE=cuda:0
# Optional performance experiment; validate depth range before robot use:
# R1_STEREO_NUM_DISPARITIES=32
