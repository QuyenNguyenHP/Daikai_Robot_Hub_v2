[Unit]
Description=Daikai Robot Hub backend (Jetson)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=unitree
WorkingDirectory=/home/unitree/Daikai_Robot_Hub_v2
Environment="HOME=/home/unitree"
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/home/unitree/Daikai_Robot_Hub_v2/.venv/bin:/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="CYCLONEDDS_HOME=/home/unitree/cyclonedds/install"
Environment="CMAKE_PREFIX_PATH=/home/unitree/cyclonedds/install"
Environment="LD_LIBRARY_PATH=/home/unitree/cyclonedds/install/lib:/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu/tegra"
Environment="XR_TELEOP_CERT=/home/unitree/.config/xr_teleoperate/cert.pem"
Environment="XR_TELEOP_KEY=/home/unitree/.config/xr_teleoperate/key.pem"
Environment="R1_YOLO_DEVICE=cuda:0"
Environment="UNITREE_NETWORK_INTERFACE=eth10"
Environment="DAIKAI_BACKEND_PORT=8010"
EnvironmentFile=-/etc/default/daikai-robot-hub
ExecStart=/home/unitree/Daikai_Robot_Hub_v2/.venv/bin/python -m backend ${UNITREE_NETWORK_INTERFACE} --host 0.0.0.0 --port ${DAIKAI_BACKEND_PORT}
Restart=on-failure
RestartSec=5
# Let FastAPI shut down XR through IPC before terminating remaining children.
KillMode=mixed
TimeoutStopSec=40
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
